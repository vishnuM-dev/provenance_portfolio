# Provenance Environment Configuration

# Amazon DynamoDB
# If these AWS keys are omitted, the app automatically runs in local DynamoDB mock mode
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=

# Cloudinary
# If Cloudinary keys are omitted, the app automatically uses local data-URI storage fallback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
